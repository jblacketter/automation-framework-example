# Template — copy to .env and fill in values. Never commit .env.
#
# This framework points at two public test targets. Recommended defaults
# (safe to use; no real credentials — automationintesting.online and
# restful-booker.herokuapp.com publish these for their demo users):
#
#   BASE_URL=https://automationintesting.online
#   API_BASE_URL=https://restful-booker.herokuapp.com
#   BROWSER=chromium
#   HEADLESS=true
#   SLOW_MO=0
#   VIEWPORT_WIDTH=1920
#   VIEWPORT_HEIGHT=1080
#   DEFAULT_TIMEOUT=30000
#   NAVIGATION_TIMEOUT=60000
#   ADMIN_USERNAME=admin
#   ADMIN_PASSWORD=password123
#   LOG_LEVEL=INFO
#   LOG_API_REQUESTS=true
#   LOG_API_RESPONSES=true
#   SCREENSHOT_ON_FAILURE=true
#   SCREENSHOT_DIR=reports/screenshots
#
# For production targets, fill in your own values below.

# --- UI target -------------------------------------------------------------
BASE_URL=
API_BASE_URL=

# --- Browser ---------------------------------------------------------------
BROWSER=
HEADLESS=
SLOW_MO=
VIEWPORT_WIDTH=
VIEWPORT_HEIGHT=

# --- Timeouts (milliseconds) -----------------------------------------------
DEFAULT_TIMEOUT=
NAVIGATION_TIMEOUT=

# --- Auth ------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=
LOG_API_REQUESTS=
LOG_API_RESPONSES=

# --- Reporting -------------------------------------------------------------
SCREENSHOT_ON_FAILURE=
SCREENSHOT_DIR=
